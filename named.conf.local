zone "gustavo.test" {
    type master;
    file "/var/lib/bind/gustavo.test.dns";
    allow-update { key "ddns-key"; };
    allow-transfer { none; };
};

zone "58.168.192.in-addr.arpa" {
    type master;
    file "/var/lib/bind/gustavo.test.rev";
    allow-update { key "ddns-key"; };
    allow-transfer { none; };
};
