$TTL    604800
@       IN      SOA     dns.gustavo.test. root.gustavo.test. (
                            1       ; Serial
                            604800  ; Refresh
                            86400   ; Retry
                            2419200 ; Expire
                            604800 ) ; Negative Cache TTL
;
@               IN      NS      dns.gustavo.test.
@               IN      NS      dhcp.gustavo.test.

; Registros A
dns.gustavo.test.    IN  A   192.168.58.10
dhcp.gustavo.test.   IN  A   192.168.58.20