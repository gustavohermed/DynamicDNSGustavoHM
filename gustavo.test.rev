$TTL    86400
@       IN      SOA     dns.gustavo.test. root.gustavo.test. (
                            1       ; Serial
                            604800  ; Refresh
                            86400   ; Retry
                            2419200 ; Expire
                            86400 ) ; Negative Cache TTL
;
@               IN      NS      dns.gustavo.test.
@               IN      NS      dhcp.gustavo.test.

; Registros PTR
10      IN  PTR dns.gustavo.test.
20      IN  PTR dhcp.gustavo.test.