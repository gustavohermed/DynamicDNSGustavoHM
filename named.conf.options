options {
    directory "/var/cache/bind";

    recursion no;
    allow-query { any; };
    listen-on { any; };
    listen-on-v6 { none; };

    dnssec-validation no;
    auth-nxdomain yes;

    allow-transfer { none; };
};

key "ddns-key" {
        algorithm hmac-sha256;
        secret "hABSDPm/L4v3KNt4tAuQnZs6cQsbdI18+oAR+GkCaUk=";
};
